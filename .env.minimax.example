# MiniMax 全家桶配置模板
# 复制为 .env.minimax 后填写，并在 .env 设置 MODEL_PROVIDER=minimax。
# 不要把真实 API Key 提交到 Git。

# API 与 OpenAI 兼容文本/视觉接口
MINIMAX_API_KEY=your_minimax_api_key
# 可选：视觉服务使用独立 Key；为空时复用 MINIMAX_API_KEY
MINIMAX_VISION_API_KEY=
MINIMAX_API_BASE_URL=https://api.minimaxi.com/v1
# Anthropic SDK 兼容接口（多模态图片/视频/Function Calling）
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# 原生图片/视频/语音/文件接口地址
MINIMAX_NATIVE_API_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_VISION_MODEL=MiniMax-M3
MINIMAX_MAX_TOKENS=8192
# false 更适合稳定执行 Function Call；如模型支持且需要思考可改为 true
MINIMAX_THINKING_ENABLED=false

# 原生图片生成/图生图（/v1/image_generation）
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_IMAGE_ASPECT_RATIO=1:1
# 可选：仅 image-01 生效；与 aspect_ratio 同时存在时以 aspect_ratio 为准
MINIMAX_IMAGE_WIDTH=
MINIMAX_IMAGE_HEIGHT=
MINIMAX_IMAGE_PROMPT_OPTIMIZER=false
MINIMAX_IMAGE_WATERMARK=false

# 原生视频生成：Hailuo 2.x/S2V 走 V1；MiniMax-H3 走 Video Generation V2
MINIMAX_VIDEO_MODEL=MiniMax-H3
# H3 使用 Video Generation V2，同时支持文本、首帧图片和图片/视频参考
MINIMAX_VIDEO_SUBJECT_MODEL=S2V-01
MINIMAX_VIDEO_RESOLUTION=1080P
# MiniMax 原生视频默认 6 秒；机器人收到 -1 时会回退到此值
MINIMAX_VIDEO_DURATION=6
MINIMAX_VIDEO_WATERMARK=false
# V1 原生接口没有 Seedance 的 ratio 字段；如需竖屏，请在 prompt 中明确 9:16。
# H3 V2 会读取 Function Call 的 ratio，并在有输入媒体时使用 adaptive。
# 若将 MINIMAX_VIDEO_MODEL 改为 MiniMax-H3，接口会自动使用 https://api.minimaxi.com/v2/video_generation，
# 支持 2K、4～15 秒，以及图片/视频参考；也可按区域覆盖 V2 的 API 根地址。
MINIMAX_VIDEO_V2_API_BASE_URL=https://api.minimaxi.com

# T2A Async 角色语音
MINIMAX_AUDIO_MODEL=speech-2.8-hd
MINIMAX_AUDIO_VOICE_ID=female-shaonv
# 用户进入 ASMR/助眠模式时使用的音色，可由管理员按角色单独覆盖
MINIMAX_ASMR_VOICE_ID=female-tianmei-jingpin
MINIMAX_AUDIO_LANGUAGE_BOOST=auto
MINIMAX_AUDIO_SAMPLE_RATE=44100
MINIMAX_AUDIO_BITRATE=256000
MINIMAX_AUDIO_FORMAT=mp3
MINIMAX_AUDIO_CHANNEL=2
# 音量限制为 1～5，默认 3；机器人会自动将更大的值压回 5
MINIMAX_AUDIO_VOLUME=3

# 文件管理：Telegram document 开关由 /admin → 功能 → 文件控制
MINIMAX_FILE_UPLOAD_PURPOSE=t2a_async_input
MINIMAX_FILE_MAX_BYTES=536870912
# MiniMax voice_clone 参考音频上限（官方限制 20MB）
MINIMAX_VOICE_CLONE_MAX_BYTES=20971520
