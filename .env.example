# localTest 运行配置模板
# 复制为 .env 后填写；不要把真实密钥提交到 Git。

# 全家桶 provider：default 使用下方通用配置；minimax 会额外加载 .env.minimax
MODEL_PROVIDER=default

# Telegram
TG_BOT_TOKEN=your_telegram_bot_token
# 允许使用管理员命令的 Telegram 用户 ID，多个 ID 用英文逗号分隔
TG_ADMIN_USER_IDS=123456789
# 可选：用于加密各用户自己的麦当劳 MCP Token；未设置时会回退派生自 TG_BOT_TOKEN
MCD_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret
# 自动按消息意图加载麦当劳 MCP；设为 false 可完全关闭对话中的自动加载（/mcd 命令仍可用）
MCD_AUTO_LOAD_ENABLED=true

# 文本模型（OpenAI 兼容接口）
OPENAI_API_KEY=your_api_key
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=deepseek-v4-pro
# 是否开启模型思考；false 会在支持的接口中传 thinking.type=disabled
OPENAI_THINKING_ENABLED=false

# 视觉模型
# 可选：图片/sticker 使用的模型；为空时回退到 OPENAI_MODEL
OPENAI_VISION_MODEL=
# 可选：视觉模型单独的 API Key 和兼容接口地址
OPENAI_VISION_API_KEY=
OPENAI_VISION_API_BASE_URL=
# true 会把含 Bot Token 的 Telegram file URL 发送给视觉提供商；仅在能接受凭据泄露风险时开启
VISION_USE_TELEGRAM_FILE_URL=false
# 视觉/媒体图片短期 URL 服务；远程视觉或 MiniMax 原生媒体接口必须能访问 PUBLIC_BASE_URL
VISION_ASSET_SERVER_HOST=0.0.0.0
VISION_ASSET_SERVER_PORT=3000
VISION_ASSET_PUBLIC_BASE_URL=http://160.16.146.27:3000
# Cloudflare R2 / Wasabi S3-compatible 公共资产存储
# R2 使用 region=auto；默认返回临时签名 URL，不要求 bucket 公开
ASSET_STORAGE_PROVIDER=r2
R2_ENABLED=true
R2_BUCKET=
R2_REGION=auto
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SESSION_TOKEN=
R2_PREFIX=role-bot
R2_URL_MODE=signed
R2_SIGNED_URL_TTL_SECONDS=86400
R2_MAX_BYTES=536870912
# 可选：public 模式下使用 r2.dev 或自定义域名根地址；末尾不要加对象文件名
R2_PUBLIC_BASE_URL=
# 旧 Wasabi 配置仍兼容：把 ASSET_STORAGE_PROVIDER 改为 wasabi 后使用 WASABI_* 变量
# Three.js 预览会复用上面的 PUBLIC_BASE_URL；链接默认有效 24 小时
THREE_VIEWER_TTL_MS=86400000
THREE_SCENE_MAX_BYTES=524288

# 受控工作区：按 Telegram 用户和会话自动隔离。相对路径会以此目录为根。
AGENT_WORKSPACE_ROOT=./agent-workspaces
AGENT_WORKSPACE_MAX_FILE_BYTES=2097152
AGENT_WORKSPACE_MAX_SEND_BYTES=20971520

# Python 执行模式：disabled（默认关闭）、docker（推荐）、remote（Cloudflare Sandbox）、local（仅显式启用，非强隔离）
CODE_EXECUTION_MODE=disabled
CODE_EXECUTION_DOCKER_IMAGE=python:3.12-slim
# Docker 网络：none（默认关闭）或 nat（Docker bridge，通过宿主机 NAT 访问外网）
CODE_EXECUTION_NETWORK_MODE=none
CODE_EXECUTION_TIMEOUT_MS=20000
# CODE_EXECUTION_MODE=remote 时填写已部署的 sandbox-worker 地址和共享 Bearer Token
SANDBOX_API_URL=
SANDBOX_API_TOKEN=

# 视频地点状态校验：默认开启；关闭后用户明确指定的视频地点优先
VIDEO_LOCATION_GUARD_ENABLED=true

# 图片生成/编辑：Seedream（当前默认）
# seedream 或 newapi；设置后端后，图片工具会按此选择提供商
IMAGE_PROVIDER=seedream
# 视频 provider：seedance 或 minimax；管理员也可在 /admin → 功能 → provider 中运行时切换
VIDEO_PROVIDER=seedance
SEEDREAM_API_BASE_URL=https://vvdance.yongmuai.com
SEEDREAM_API_KEY=your_seedream_api_key
# 支持 dola-seedream-5-0-pro-260628（Pro）或 seedream-5-0-lite-260128（Lite）
SEEDREAM_MODEL=dola-seedream-5-0-pro-260628
# Pro 支持 1K/2K；Lite 支持 2K/3K/4K，也可填写符合模型限制的宽x高
SEEDREAM_IMAGE_SIZE=2K
# 独立的 Seedream Lite 测试脚本使用；按文档以 Bearer Token 发送 Key，不要将真实值提交到 Git。
SEEDREAM_LITE_API_KEY=
SEEDREAM_LITE_API_SECRET=

# 图片生成/编辑：NewAPI（兼容保留，IMAGE_PROVIDER=newapi 时使用）
# 可填根域名或包含 /v1；程序会自动规范为 OpenAI 兼容的 /v1 路径。
NEWAPI_BASE_URL=https://your-newapi-host
NEWAPI_API_KEY=your_newapi_key
NEWAPI_IMAGE_MODEL=gemini-3.1-flash-image
# T2I 默认输出尺寸；选择图片比例时会自动使用相应的兼容尺寸。
NEWAPI_IMAGE_SIZE=1024x1024
# I2I 编辑接口的模型与尺寸
NEWAPI_IMAGE_EDIT_MODEL=your_newapi_image_edit_model
NEWAPI_IMAGE_EDIT_SIZE=1024x1024

# 视频生成：Seedance
SEEDANCE_API_BASE_URL=https://vvdance.ai
SEEDANCE_API_TOKEN=your_vvdance_api_key
SEEDANCE_VIDEO_MODEL=dreamina-seedance-2-0-mini-260615
# 默认视频分辨率；具体可用值以服务端模型能力为准
SEEDANCE_VIDEO_RESOLUTION=480p
# 画幅比例，例如 9:16 或 16:9
SEEDANCE_VIDEO_RATIO=16:9
# 时长：-1 为智能时长，或填写 4～15 秒
SEEDANCE_VIDEO_DURATION=-1
# 是否生成音频
SEEDANCE_VIDEO_GENERATE_AUDIO=true

# 媒体提示词
# freeform 直接使用模型生成的提示词；guided 追加 provider 适配约束
MEDIA_PROMPT_MODE=freeform
# 是否在图片任务后台再用文本模型结合对话上下文优化一次 prompt
IMAGE_PROMPT_REFINEMENT_ENABLED=true

# 角色日程与睡眠模式
# 每个角色每天生成一份分钟级日程；关闭后不会注入日程、睡眠拦截或主动消息
ROLE_SCHEDULE_ENABLED=true
# 所有角色日程使用的 IANA 时区
ROLE_SCHEDULE_TIMEZONE=Asia/Shanghai
# 角色睡觉时，收到普通消息后直接不回复的概率
ROLE_SCHEDULE_SLEEP_IGNORE_PROBABILITY=0.35
# 未直接忽略时，延迟回复的概率；剩余概率立即回复
ROLE_SCHEDULE_SLEEP_DELAY_PROBABILITY=0.45
# 延迟回复的随机范围（毫秒）
ROLE_SCHEDULE_SLEEP_DELAY_MIN_MS=15000
ROLE_SCHEDULE_SLEEP_DELAY_MAX_MS=180000
# 每 20 秒检查闲暇状态时，向当前角色会话主动分享一条消息的概率
ROLE_SCHEDULE_PROACTIVE_PROBABILITY=0.04
# 主动分享的最短间隔（毫秒），避免在闲暇时段连续打扰
ROLE_SCHEDULE_PROACTIVE_COOLDOWN_MS=600000
# 主动分享选择图片而不是文字的概率；仍需通过 /admin 开启图片功能
ROLE_SCHEDULE_PROACTIVE_IMAGE_PROBABILITY=0.35
# 日程行为 roll：进入行为时决定是否执行、能否完成、失败后是否重试，以及重试放到明天的概率
ROLE_BEHAVIOR_EXECUTION_PROBABILITY=0.85
ROLE_BEHAVIOR_COMPLETION_PROBABILITY=0.8
ROLE_BEHAVIOR_RETRY_PROBABILITY=0.55
ROLE_BEHAVIOR_TOMORROW_PROBABILITY=0.35

# 联网搜索
# 自托管 SearXNG 地址；未配置时使用免费的 DuckDuckGo
SEARXNG_BASE_URL=
# 旧版 Brave 配置（当前代码不会优先调用）；如后续启用再填写
BRAVE_SEARCH_API_KEY=
